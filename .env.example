# ==============================================================================
# PiMusic Frontend - Variables de Entorno
# ==============================================================================

# URL base del Backend FastAPI de PiMusic.
# - En desarrollo local con Vite proxy: Déjalo vacío o usa 'http://localhost:5000'
# - En producción con Nginx / Reverse Proxy: Déjalo vacío (las llamadas irán a '/api/...')
# - Para conectar a un servidor remoto (ej. Raspberry Pi en la red local): 'http://192.168.1.50:5000'
VITE_API_URL=

# Puerto del servidor de desarrollo Vite (por defecto: 3000)
PORT=3000

# URL destino para el proxy de desarrollo de Vite (cuando se use 'npm run dev')
VITE_BACKEND_URL=http://localhost:5000
